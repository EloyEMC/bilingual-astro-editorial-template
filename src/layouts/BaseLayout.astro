---
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.astro";
import Seo, { type BookSeoData } from "../components/Seo.astro";
import type { Locale } from "../data/books";

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  alternatePaths: Record<Locale, string>;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "book";
  book?: BookSeoData;
  immersive?: boolean;
  bookPage?: boolean;
  showLocaleSwitch?: boolean;
}

const {
  title,
  description,
  locale,
  path,
  alternatePaths,
  image,
  imageAlt,
  ogType,
  book,
  immersive = false,
  bookPage = false,
  showLocaleSwitch = !immersive,
} = Astro.props;
const alternateLocale: Locale = locale === "es" ? "en" : "es";
---
<!doctype html>
<html lang={locale} class:list={{ immersive, "book-page": bookPage }}>
  <head>
    <meta charset="UTF-8" />
    <Seo
      title={title}
      description={description}
      path={path}
      alternatePaths={alternatePaths}
      image={image}
      imageAlt={imageAlt}
      locale={locale}
      ogType={ogType}
      book={book}
    />
    <slot name="head" />
  </head>
  <body class:list={{ immersive, "book-page": bookPage }}>
    {showLocaleSwitch && (
          <a
            class="locale-switch"
            href={alternatePaths[alternateLocale]}
            lang={alternateLocale}
            hreflang={alternateLocale}
            aria-label={locale === "es" ? "Leer en inglés" : "Read in Spanish"}
          >
            {locale === "es" ? "EN" : "ES"}
          </a>
    )}
    <main><slot /></main>
    <CookieConsent locale={locale} />
  </body>
</html>
