---
import type { BookContent } from "../data/books";
interface Props { content: BookContent; cover: string; caseImage: string; }
const { content, cover, caseImage } = Astro.props;
---
<a class="book-card" href={content.path} data-wormhole-link aria-label={content.cta}>
  <span class="book-card__scene" aria-hidden="true">
    <span class="book-card__book">
      <span class="book-card__cover"><img src={cover} alt="" loading="lazy" /></span>
      <span class="book-card__pages"></span>
      <span class="book-card__back"><img src={caseImage} alt="" loading="lazy" /></span>
    </span>
  </span>
  <span class="book-card__label">{content.title}<small>{content.cta} ↗</small></span>
</a>
