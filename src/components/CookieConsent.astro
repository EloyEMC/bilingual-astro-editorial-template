---
import type { Locale } from "../data/books";
const { locale } = Astro.props as { locale: Locale };
const copy = locale === "es" ? { title: "Tu privacidad", description: "Esta plantilla deja el consentimiento como un ejemplo. Configurá las tecnologías de tu proyecto antes de publicar.", accept: "Aceptar", reject: "Rechazar", cookies: "Política de cookies", privacy: "Política de privacidad" } : { title: "Your privacy", description: "This template keeps consent as an example. Configure your project's technologies before publishing.", accept: "Accept", reject: "Reject", cookies: "Cookie policy", privacy: "Privacy policy" };
const cookiePath = `/${locale}/legal/cookies/`;
const privacyPath = `/${locale}/legal/${locale === "es" ? "privacidad" : "privacy"}/`;
---
<aside class="cookie-consent" data-cookie-consent aria-label={copy.title} hidden>
  <div class="cookie-consent__content"><p class="cookie-consent__title">{copy.title}</p><p class="cookie-consent__description">{copy.description}</p><p><a href={cookiePath}>{copy.cookies}</a> · <a href={privacyPath}>{copy.privacy}</a></p></div>
  <div class="cookie-consent__actions"><button type="button" data-cookie-consent-accept>{copy.accept}</button><button type="button" data-cookie-consent-reject>{copy.reject}</button></div>
</aside>
<script is:inline>
  (() => { const banner = document.querySelector("[data-cookie-consent]"); if (!banner) return; const hide = () => { banner.hidden = true; }; const key = "example-template-consent"; if (localStorage.getItem(key)) hide(); else banner.hidden = false; banner.querySelector("[data-cookie-consent-accept]")?.addEventListener("click", () => { localStorage.setItem(key, "accepted"); hide(); }); banner.querySelector("[data-cookie-consent-reject]")?.addEventListener("click", () => { localStorage.setItem(key, "rejected"); hide(); }); document.addEventListener("click", (event) => { if (event.target.closest("[data-cookie-consent-reset]")) { localStorage.removeItem(key); banner.hidden = false; } }); })();
</script>
