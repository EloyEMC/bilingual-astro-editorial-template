---
import type { Locale } from "../data/books";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === "es"
  ? {
      title: "Tu privacidad",
      description:
        "Usamos analítica opcional para entender el uso del sitio. No se carga Google Analytics hasta que la aceptes.",
      accept: "Aceptar analítica",
      reject: "Rechazar",
      links: "Consulta la Política de cookies y la Política de privacidad.",
      cookies: "Política de cookies",
      privacy: "Política de privacidad",
      storageError:
        "No podemos guardar tu elección. La analítica permanecerá desactivada.",
    }
  : {
      title: "Your privacy",
      description:
        "We use optional analytics to understand website use. Google Analytics does not load until you accept it.",
      accept: "Accept analytics",
      reject: "Reject",
      links: "Read the Cookie policy and Privacy policy.",
      cookies: "Cookie policy",
      privacy: "Privacy policy",
      storageError:
        "We cannot save your choice. Analytics will remain disabled.",
    };
const cookiePath = `/${locale}/legal/cookies/`;
const privacyPath = `/${locale}/legal/${locale === "es" ? "privacidad" : "privacy"}/`;
---

<aside
  class="cookie-consent"
  data-cookie-consent
  aria-label={copy.title}
  aria-live="polite"
  hidden
>
  <div class="cookie-consent__content">
    <p class="cookie-consent__title">{copy.title}</p>
    <p class="cookie-consent__description">{copy.description}</p>
    <p class="cookie-consent__links">
      <a href={cookiePath}>{copy.cookies}</a>
      <span aria-hidden="true"> · </span>
      <a href={privacyPath}>{copy.privacy}</a>
    </p>
    <p class="cookie-consent__error" data-cookie-consent-error hidden>
      {copy.storageError}
    </p>
  </div>
  <div class="cookie-consent__actions">
    <button type="button" class="cookie-consent__accept" data-cookie-consent-accept>
      {copy.accept}
    </button>
    <button type="button" class="cookie-consent__reject" data-cookie-consent-reject>
      {copy.reject}
    </button>
  </div>
</aside>

<script is:inline>
  (() => {
    const storageKey = "sterling-books-analytics-consent-v1";
    const measurementId = "G-V1LH71HG1E";
    const banner = document.querySelector("[data-cookie-consent]");
    const error = document.querySelector("[data-cookie-consent-error]");

    if (!banner) return;

    const getConsent = () => {
      try {
        const value = window.localStorage.getItem(storageKey);
        return value === "accepted" || value === "rejected" ? value : null;
      } catch {
        return null;
      }
    };

    const saveConsent = (value) => {
      try {
        window.localStorage.setItem(storageKey, value);
        return true;
      } catch {
        return false;
      }
    };

    const loadAnalytics = () => {
      if (window.__sterlingGa4Loaded) return;

      window.__sterlingGa4Loaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
      window.gtag("config", measurementId);

      if (document.getElementById("sterling-books-ga4-loader")) return;

      const script = document.createElement("script");
      script.id = "sterling-books-ga4-loader";
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.append(script);
    };

    const showBanner = () => {
      banner.hidden = false;
    };

    const hideBanner = () => {
      banner.hidden = true;
    };

    const consent = getConsent();
    if (consent === "accepted") {
      loadAnalytics();
      hideBanner();
    } else if (consent === "rejected") {
      hideBanner();
    } else {
      showBanner();
    }

    banner.querySelector("[data-cookie-consent-accept]")?.addEventListener("click", () => {
      if (!saveConsent("accepted")) {
        error.hidden = false;
        showBanner();
        return;
      }
      loadAnalytics();
      hideBanner();
    });

    banner.querySelector("[data-cookie-consent-reject]")?.addEventListener("click", () => {
      if (!saveConsent("rejected")) {
        error.hidden = false;
        showBanner();
        return;
      }
      hideBanner();
    });

    document.addEventListener("click", (event) => {
      const reset = event.target.closest("[data-cookie-consent-reset]");
      if (!reset) return;

      try {
        window.localStorage.removeItem(storageKey);
      } catch {
        // If storage is unavailable, analytics stays disabled on future page loads.
      }
      error.hidden = true;
      showBanner();
      banner.querySelector("[data-cookie-consent-accept]")?.focus();
    });
  })();
</script>
