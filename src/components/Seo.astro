---
import type { BookFaq, Locale } from "../data/books";

export interface BookWorkExample {
  name: string;
  bookFormat: "https://schema.org/Hardcover" | "https://schema.org/EBook";
  url: string;
  datePublished: string;
  numberOfPages: number;
  authors: string[];
  publisher: string;
  isbn?: string;
  asin?: string;
}

export interface BookSeoData {
  name: string;
  language: Locale;
  authors: string[];
  datePublished: string;
  publisher: string;
  sameAs: string[];
  workExamples: BookWorkExample[];
  faqs?: BookFaq[];
}

export interface Props {
  title: string;
  description: string;
  path: string;
  alternatePaths: Record<Locale, string>;
  locale: Locale;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "book";
  book?: BookSeoData;
}

const {
  title,
  description,
  path,
  alternatePaths,
  locale,
  image = "/media/template-cover-en.svg",
  imageAlt,
  ogType = "website",
  book,
} = Astro.props;
if (!Astro.site) throw new Error("Astro.site is required to generate SEO metadata");
const siteUrl = Astro.site.toString().replace(/\/$/, "");
    const withTrailingSlash = (value: string) =>
      value.endsWith("/") ? value : `${value}/`;
    const canonical = new URL(withTrailingSlash(path), `${siteUrl}/`).toString();
    const imageUrl = new URL(image, `${siteUrl}/`).toString();
    const alternateUrls = {
      es: new URL(withTrailingSlash(alternatePaths.es), `${siteUrl}/`).toString(),
      en: new URL(withTrailingSlash(alternatePaths.en), `${siteUrl}/`).toString(),
    };
    const homeUrl = new URL(`/${locale}/`, `${siteUrl}/`).toString();
    const pageId = `${canonical}#webpage`;
    const bookId = `${canonical}#book`;
    const faqId = `${canonical}#faq`;
    const breadcrumbId = `${canonical}#breadcrumb`;
    const faqs = book?.faqs;
    const bookNode = book
      ? {
          "@type": "Book",
          "@id": bookId,
          name: book.name,
          description,
          image: imageUrl,
          url: canonical,
          inLanguage: book.language,
          mainEntityOfPage: { "@id": pageId },
          ...(faqs?.length ? { subjectOf: { "@id": faqId } } : {}),
          author: book.authors.map((name) => ({ "@type": "Person", name })),
          datePublished: book.datePublished,
          publisher: { "@type": "Organization", name: book.publisher },
          sameAs: book.sameAs,
          workExample: book.workExamples.map(
            ({ asin, authors, publisher, ...edition }, index) => ({
              "@type": "Book",
              "@id": `${canonical}#edition-${index + 1}`,
              ...edition,
              inLanguage: book.language,
              author: authors.map((name) => ({ "@type": "Person", name })),
              publisher: { "@type": "Organization", name: publisher },
              ...(asin
                ? {
                    identifier: {
                      "@type": "PropertyValue",
                      propertyID: "ASIN",
                      value: asin,
                    },
                  }
                : {}),
            }),
          ),
        }
      : null;
    const jsonLd = bookNode
      ? {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "WebPage",
              "@id": pageId,
              url: canonical,
              name: title,
              description,
              inLanguage: locale,
              breadcrumb: { "@id": breadcrumbId },
              mainEntity: { "@id": bookId },
            },
            bookNode,
            {
              "@type": "BreadcrumbList",
              "@id": breadcrumbId,
              inLanguage: locale,
              itemListElement: [
                {
                  "@type": "ListItem",
                  position: 1,
                  name: locale === "es" ? "Inicio" : "Home",
                  item: { "@id": homeUrl },
                },
                {
                  "@type": "ListItem",
                  position: 2,
                  name: title,
                  item: { "@id": canonical },
                },
              ],
            },
            ...(faqs?.length
              ? [
                  {
                    "@type": "FAQPage",
                    "@id": faqId,
                    isPartOf: { "@id": pageId },
                    inLanguage: locale,
                    mainEntity: faqs.map((faq) => ({
                      "@type": "Question",
                      name: faq.question,
                      acceptedAnswer: { "@type": "Answer", text: faq.answer },
                    })),
                  },
                ]
              : []),
          ],
        }
      : null;
---
<title>{title} — Example Astro Template</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Example Astro Template" />
<meta property="og:title" content={`${title} - Example Astro Template`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="1800" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
<meta
  property="og:locale:alternate"
  content={locale === "es" ? "en_US" : "es_ES"}
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} - Example Astro Template`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="es" href={alternateUrls.es} />
<link rel="alternate" hreflang="en" href={alternateUrls.en} />
<link rel="alternate" hreflang="x-default" href={alternateUrls.es} />
{jsonLd && (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
)}
