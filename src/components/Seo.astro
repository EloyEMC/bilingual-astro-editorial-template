---
interface Props {
  title: string;
  description: string;
  path: string;
  locale: "es" | "en";
  image?: string;
}
const { title, description, path, locale, image = "/media/codigo-tempus-cover-en.jpg" } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://sterlingbooks.example";
const canonical = new URL(path, `${siteUrl}/`).toString();
const imageUrl = new URL(image, `${siteUrl}/`).toString();
const spanishPath = path.replace(/^\/en/, "/es").replace("/book/", "/libro/").replace("tempus-code", "codigo-tempus");
const englishPath = path.replace(/^\/es/, "/en").replace("/libro/", "/book/").replace("codigo-tempus", "tempus-code");
---
<title>{title} — Sterling Books</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Sterling Books" />
<meta property="og:title" content={`${title} — Sterling Books`} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} — Sterling Books`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="es" href={`${siteUrl}${spanishPath}`} />
<link rel="alternate" hreflang="en" href={`${siteUrl}${englishPath}`} />
<link rel="alternate" hreflang="x-default" href={`${siteUrl}${englishPath}`} />
