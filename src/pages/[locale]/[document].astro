---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  attributionDocuments,
  type AttributionDocument,
} from "../../data/attributions";

export function getStaticPaths() {
  return attributionDocuments.map((page) => ({
    params: { locale: page.locale, document: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: AttributionDocument };
const alternatePage = attributionDocuments.find(
  (candidate) => candidate.locale !== page.locale,
);

if (!alternatePage) {
  throw new Error(`Missing alternate attribution page for ${page.path}`);
}

const alternatePaths = {
  es: page.locale === "es" ? page.path : alternatePage.path,
  en: page.locale === "en" ? page.path : alternatePage.path,
};
const copy = page.locale === "es"
  ? {
      backHome: "Volver al inicio",
      breadcrumb: "Navegación de atribuciones",
      projects: "Obras atribuidas",
    }
  : {
      backHome: "Back to home",
      breadcrumb: "Attribution navigation",
      projects: "Attributed works",
    };
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={page.locale}
  path={page.path}
  alternatePaths={alternatePaths}
  showLocaleSwitch
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <article class="legal-page attribution-page" aria-labelledby="attribution-page-title">
    <header class="legal-page__header">
      <nav class="legal-page__breadcrumb" aria-label={copy.breadcrumb}>
        <a href={`/${page.locale}/`}>
          <span aria-hidden="true">←</span>
          {copy.backHome}
        </a>
        <span class="legal-page__breadcrumb-separator" aria-hidden="true">/</span>
        <span aria-current="page">{page.title}</span>
      </nav>

      <p class="legal-page__eyebrow">{page.identity}</p>
      <h1 id="attribution-page-title">{page.title}</h1>
      <p class="legal-page__status" role="status">{page.status}</p>
    </header>

    <div class="legal-page__content attribution-page__content">
      <section class="attribution-page__introduction">
        {page.introduction.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section aria-labelledby="attributed-works-title">
        <h2 id="attributed-works-title">{copy.projects}</h2>
        <div class="attribution-page__projects">
          {page.projects.map((project) => (
            <section class="attribution-page__project" aria-labelledby={`${project.name}-title`}>
              <h3 id={`${project.name}-title`}>{project.name}</h3>
              <dl>
                <div>
                  <dt>{project.authorLabel}</dt>
                  <dd>{project.author}</dd>
                </div>
                <div>
                  <dt>{project.versionLabel}</dt>
                  <dd>{project.version}</dd>
                </div>
                <div>
                  <dt>{project.repositoryLabel}</dt>
                  <dd>
                    <a href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">
                      {project.repositoryText}
                    </a>
                  </dd>
                </div>
                <div>
                  <dt>{project.useLabel}</dt>
                  <dd>{project.use}</dd>
                </div>
                <div>
                  <dt>{project.licenseLabel}</dt>
                  <dd>{project.license}</dd>
                </div>
              </dl>
            </section>
          ))}
        </div>
      </section>

      <section>
        <h2>{page.adaptations.heading}</h2>
        {page.adaptations.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section class="attribution-page__license">
        <h2>{page.license.heading}</h2>
        <p>{page.license.introduction}</p>
        <h3>{page.license.copyrightHeading}</h3>
        <ul>
          {page.license.copyrightLines.map((line) => <li>{line}</li>)}
        </ul>
        <pre>{page.license.text}</pre>
      </section>
    </div>
  </article>
</BaseLayout>
