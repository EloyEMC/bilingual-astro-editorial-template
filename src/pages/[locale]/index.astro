---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { exampleBook, type Locale } from "../../data/books";

export function getStaticPaths() {
  return ["es", "en"].map((locale) => ({
    params: { locale },
    props: { locale: locale as Locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const content = exampleBook.content[locale];
const homeSeo = locale === "es"
  ? {
      title: "Entrada interactiva de ejemplo",
      description:
        "Explorá una experiencia interactiva de ejemplo para tu publicación bilingüe.",
    }
  : {
      title: "Example interactive entry",
      description:
        "Explore a generic interactive experience for your bilingual publication.",
    };
const particleTitle = locale === "es" ? "EJEMPLO" : "EXAMPLE";
const alternatePaths = { es: "/es/", en: "/en/" };
---
<BaseLayout
  title={homeSeo.title}
  description={homeSeo.description}
  locale={locale}
  path={`/${locale}/`}
  alternatePaths={alternatePaths}
  image={content.cover}
  imageAlt={content.coverAlt}
  immersive
  showLocaleSwitch
>
  <section class="wormhole-home" aria-label={homeSeo.title}>
    <iframe
      class="wormhole-home__frame"
      data-wormhole-frame
      src={`/wormhole-home.html?locale=${locale}&amazon=${encodeURIComponent(content.amazonUrl)}&apple=${encodeURIComponent(content.appleBooksUrl)}`}
      title={locale === "es" ? "Escena espacial interactiva" : "Interactive space scene"}
    ></iframe>
    <a
      class="wormhole-home__cover-cta"
      data-hyper-travel
      href={content.path}
      aria-label={content.cta}
    >
      <img
        src={content.cover}
        alt={content.coverAlt}
        width="1200"
        height="1800"
      />
    </a>
    <div class="title-particles" aria-hidden="true">
      <canvas data-title-particles data-title={particleTitle}></canvas>
    </div>
    <h1
      class="title-particles__fallback"
      data-title-fallback
      data-title={particleTitle}>{particleTitle}</h1
    >
  </section>
</BaseLayout>
<script src="../../scripts/title-particles.ts"></script>

<style>
  .wormhole-home__cover-cta {
    position: absolute;
    z-index: 4;
    top: 68%;
    left: 50%;
    width: clamp(72px, 9vw, 112px);
    border-radius: 4px;
    box-shadow:
      0 0 0 1px rgba(238, 248, 255, 0.88),
      0 0 24px rgba(182, 224, 255, 0.72),
      0 12px 32px rgba(0, 0, 0, 0.72);
    line-height: 0;
    transform: translate(-50%, -50%) scale(1);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .wormhole-home__cover-cta img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  .wormhole-home__cover-cta:hover,
  .wormhole-home__cover-cta:focus-visible {
    transform: translate(-50%, -50%) scale(2);
  }

  .wormhole-home__cover-cta:focus-visible {
    outline: 3px solid #8fdcff;
    outline-offset: 4px;
  }

  @media (max-height: 520px) and (orientation: landscape) {
    .wormhole-home__cover-cta {
      top: 70%;
      width: clamp(48px, 16vh, 72px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wormhole-home__cover-cta {
      transition: none;
    }
  }
</style>
