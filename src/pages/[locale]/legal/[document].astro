---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  legalDocuments,
  type LegalDocument,
} from "../../../data/legal";

export function getStaticPaths() {
  return legalDocuments.map((page) => ({
    params: { locale: page.locale, document: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: LegalDocument };
const alternateSlug = {
  "aviso-legal": "legal-notice",
  privacidad: "privacy",
  cookies: "cookies",
  terminos: "terms",
  "legal-notice": "aviso-legal",
  privacy: "privacidad",
  terms: "terminos",
}[page.slug];
const alternatePage = legalDocuments.find(
  (candidate) =>
    candidate.locale !== page.locale && candidate.slug === alternateSlug,
);

if (!alternatePage) {
  throw new Error(`Missing alternate legal page for ${page.path}`);
}

const alternatePaths = {
  es: page.locale === "es" ? page.path : alternatePage.path,
  en: page.locale === "en" ? page.path : alternatePage.path,
};
const copy = page.locale === "es"
  ? {
      backHome: "Volver al inicio",
      breadcrumb: "Navegación del documento legal",
      identity: "CÓDIGO TEMPUS / STERLING BOOKS",
      resetConsent: "Restablecer consentimiento de cookies",
    }
  : {
      backHome: "Back to home",
      breadcrumb: "Legal document navigation",
      identity: "THE TEMPUS CODE / STERLING BOOKS",
      resetConsent: "Reset cookie consent",
    };
const isCookiePolicy = page.slug === "cookies";
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={page.locale}
  path={page.path}
  alternatePaths={alternatePaths}
  showLocaleSwitch
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <article class="legal-page" aria-labelledby="legal-page-title">
    <header class="legal-page__header">
      <nav class="legal-page__breadcrumb" aria-label={copy.breadcrumb}>
        <a href={`/${page.locale}/`}>
          <span aria-hidden="true">←</span>
          {copy.backHome}
        </a>
        <span class="legal-page__breadcrumb-separator" aria-hidden="true">/</span>
        <span aria-current="page">{page.title}</span>
      </nav>

      <p class="legal-page__eyebrow">{copy.identity}</p>
      <h1 id="legal-page-title">{page.title}</h1>
      <p class="legal-page__status" role="status">{page.status}</p>
    </header>

    <div class="legal-page__content">
      {page.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.items && (
            <ul>
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      ))}
      {isCookiePolicy && (
        <section class="legal-page__consent-control">
          <h2>{copy.resetConsent}</h2>
          <p>
            {page.locale === "es"
              ? "Al restablecer la preferencia, el aviso volverá a mostrarse y podrás elegir de nuevo."
              : "Resetting your preference shows the notice again so you can choose again."}
          </p>
          <button type="button" data-cookie-consent-reset>
            {copy.resetConsent}
          </button>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
