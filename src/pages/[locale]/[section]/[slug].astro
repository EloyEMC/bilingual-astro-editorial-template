---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { exampleBook, type Locale } from "../../../data/books";

export function getStaticPaths() {
  return [
    {
      params: { locale: "es", section: "libro", slug: "titulo-de-ejemplo" },
      props: { locale: "es" as Locale },
    },
    {
      params: { locale: "en", section: "book", slug: "example-title" },
      props: { locale: "en" as Locale },
    },
  ];
}

const { locale } = Astro.props as { locale: Locale };
const content = exampleBook.content[locale];
const dossier = content.dossier;
const alternatePaths = {
es: exampleBook.content.es.path,
  en: exampleBook.content.en.path,
};
const dossierId = `book-dossier-${locale}`;
const authors = ["Example Author"];
---
<BaseLayout
  title={content.title}
  description={content.description}
  locale={locale}
  path={content.path}
  alternatePaths={alternatePaths}
  image={content.cover}
  imageAlt={content.coverAlt}
  ogType="book"
  book={{
    name: dossier.fullTitle,
    language: locale,
    authors,
    datePublished: "2026-09-06",
    publisher: "Independently published",
    sameAs: [content.amazonUrl, content.appleBooksUrl],
    workExamples: [
      {
        name: `${dossier.fullTitle} — ${dossier.hardcoverHeading}`,
        bookFormat: "https://schema.org/Hardcover",
        url: content.amazonUrl,
        datePublished: "2026-09-06",
        numberOfPages: locale === "es" ? 264 : 257,
        authors,
        publisher: dossier.amazonHardcover.publisher,
        isbn: dossier.amazonHardcover.isbn13,
        asin: dossier.amazonHardcover.asin,
      },
      {
        name: `${dossier.fullTitle} — ${dossier.appleHeading}`,
        bookFormat: "https://schema.org/EBook",
        url: content.appleBooksUrl,
        datePublished: "2026-09-10",
        numberOfPages: locale === "es" ? 258 : 259,
        authors: [dossier.appleEbook.author],
        publisher: dossier.appleEbook.publisher,
      },
    ],
    faqs: dossier.faqs,
  }}
  immersive
  bookPage
  showLocaleSwitch
>
  <div class="book-landing-shell">
    <iframe
      class="book-landing__frame"
      data-book-wormhole-frame
      src={`/wormhole-home.html?locale=${locale}&amazon=${encodeURIComponent(content.amazonUrl)}&apple=${encodeURIComponent(content.appleBooksUrl)}`}
      title={locale === "es" ? "Escena espacial" : "Space scene"}
      aria-hidden="true"
      tabindex="-1"
    ></iframe>

    <article class="book-landing" aria-labelledby="book-title">
      <div class="book-landing__visual">
        <a
          class="book-landing__cover-trigger"
          href={`#${dossierId}`}
          data-dossier-open
          aria-haspopup="dialog"
          aria-controls={dossierId}
          aria-label={dossier.openCoverLabel}
        >
          <img
            src={content.cover}
            alt={content.coverAlt}
            width="1200"
            height="1800"
          />
        </a>
        <a
          class="book-landing__tap-trigger"
          href={`#${dossierId}`}
          data-dossier-open
          aria-haspopup="dialog"
          aria-controls={dossierId}
          aria-label={dossier.openControlLabel}
        >
          <img
            src="/media/tap.svg"
            alt=""
            aria-hidden="true"
            width="64"
            height="64"
          />
        </a>
      </div>

      <div class="book-landing__copy">
        <nav
          class="book-landing__breadcrumb"
          aria-label={locale === "es" ? "Ruta de navegación" : "Breadcrumb"}
        >
          <ol>
            <li>
              <a href={`/${locale}/`}>
                {locale === "es" ? "Inicio" : "Home"}
              </a>
            </li>
            <li aria-current="page">{content.title}</li>
          </ol>
        </nav>
        <p class="book-landing__collection">
          {exampleBook.collection} <span aria-hidden="true">·</span> {exampleBook.number}
        </p>
        <p class="book-landing__availability">{content.availability}</p>
        <h1 id="book-title">{content.title}</h1>
        <p class="book-landing__subtitle">{content.subtitle}</p>
        <p class="book-landing__description">{content.description}</p>
        <dl class="book-landing__details">
          <div>
            <dt>{locale === "es" ? "Idioma" : "Language"}</dt>
            <dd>{content.language}</dd>
          </div>
        </dl>
        <div class="book-landing__marketplaces" role="group" aria-label={locale === "es" ? "Comprar el libro" : "Buy the book"}>
          <a href={content.amazonUrl} target="_blank" rel="noopener noreferrer">Amazon</a>
          <a href={content.appleBooksUrl} target="_blank" rel="noopener noreferrer">Apple Books</a>
        </div>
        <a class="book-landing__back" href={`/${locale}/`}>
          <span aria-hidden="true">←</span> {content.backHome}
        </a>
      </div>
    </article>

    <dialog id={dossierId} class="book-dossier" data-book-dossier aria-labelledby={`${dossierId}-title`}>
      <article class="book-dossier__article">
        <header class="book-dossier__header">
          <div>
            <p class="book-dossier__eyebrow">{dossier.heading}</p>
            <h2 id={`${dossierId}-title`}>{dossier.fullTitle}</h2>
          </div>
          <button class="book-dossier__close" type="button" data-dossier-close aria-label={dossier.closeLabel} hidden>
            <span aria-hidden="true">×</span>
          </button>
        </header>

        <section class="book-dossier__section" aria-labelledby={`${dossierId}-synopsis`}>
          <h3 id={`${dossierId}-synopsis`}>{dossier.synopsisHeading}</h3>
          {dossier.synopsis.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="book-dossier__section" aria-labelledby={`${dossierId}-topics`}>
          <h3 id={`${dossierId}-topics`}>{dossier.topicsHeading}</h3>
          <ul class="book-dossier__topics">
            {dossier.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        </section>

        <section class="book-dossier__section" aria-labelledby={`${dossierId}-editions`}>
          <h3 id={`${dossierId}-editions`}>{dossier.editionsHeading}</h3>
          <div class="book-dossier__editions">
            <section>
              <h4>{dossier.amazonHeading}</h4>
              <p class="book-dossier__fact-label">{dossier.amazonFormatsLabel}</p>
              <ul>
                {dossier.amazonFormats.map((format) => <li>{format}</li>)}
              </ul>
              <h4>{dossier.hardcoverHeading}</h4>
              <dl class="book-dossier__facts">
                <div><dt>{dossier.factsLabels.byline}</dt><dd>{dossier.amazonHardcover.byline}</dd></div>
                <div><dt>{dossier.factsLabels.publisher}</dt><dd>{dossier.amazonHardcover.publisher}</dd></div>
                <div><dt>{dossier.factsLabels.publicationDate}</dt><dd>{dossier.amazonHardcover.publicationDate}</dd></div>
                <div><dt>{dossier.factsLabels.language}</dt><dd>{dossier.amazonHardcover.language}</dd></div>
                <div><dt>{dossier.factsLabels.pages}</dt><dd>{dossier.amazonHardcover.pages}</dd></div>
                <div><dt>{dossier.factsLabels.isbn13}</dt><dd>{dossier.amazonHardcover.isbn13}</dd></div>
                <div><dt>{dossier.factsLabels.asin}</dt><dd>{dossier.amazonHardcover.asin}</dd></div>
              </dl>
            </section>
            <section>
              <h4>{dossier.appleHeading}</h4>
              <dl class="book-dossier__facts">
                <div><dt>{dossier.factsLabels.author}</dt><dd>{dossier.appleEbook.author}</dd></div>
                <div><dt>{dossier.factsLabels.publisher}</dt><dd>{dossier.appleEbook.publisher}</dd></div>
                <div><dt>{dossier.factsLabels.availabilityDate}</dt><dd>{dossier.appleEbook.availabilityDate}</dd></div>
                <div><dt>{dossier.factsLabels.language}</dt><dd>{dossier.appleEbook.language}</dd></div>
                <div><dt>{dossier.factsLabels.pages}</dt><dd>{dossier.appleEbook.pages}</dd></div>
                <div><dt>{dossier.factsLabels.format}</dt><dd>{dossier.appleEbook.format}</dd></div>
                <div><dt>{dossier.factsLabels.seller}</dt><dd>{dossier.appleEbook.seller}</dd></div>
              </dl>
            </section>
          </div>
          <nav class="book-dossier__links" aria-label={dossier.retailerLinksLabel}>
            <a href={content.amazonUrl} target="_blank" rel="noopener noreferrer">Amazon</a>
            <a href={content.appleBooksUrl} target="_blank" rel="noopener noreferrer">Apple Books</a>
          </nav>
        </section>

        <section class="book-dossier__section" aria-labelledby={`${dossierId}-foundation`}>
          <h3 id={`${dossierId}-foundation`}>{dossier.foundationHeading}</h3>
          <p>{dossier.foundationIntroduction}</p>
          <nav aria-label={dossier.foundationLinksLabel}>
            <ul class="book-dossier__source-links">
              {dossier.foundationLinks.map((link) => (
                <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a></li>
              ))}
            </ul>
          </nav>
        </section>

        <section class="book-dossier__section" aria-labelledby={`${dossierId}-faq`}>
          <h3 id={`${dossierId}-faq`}>{dossier.faqHeading}</h3>
          <dl class="book-dossier__faq">
            {dossier.faqs.map((faq) => <div><dt>{faq.question}</dt><dd>{faq.answer}</dd></div>)}
          </dl>
        </section>
      </article>
    </dialog>
  </div>
</BaseLayout>
    <script src="../../../scripts/book-landing.ts"></script>

    <style>
      .book-landing__breadcrumb {
        margin-bottom: 0.65rem;
        color: rgba(244, 230, 202, 0.72);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
      }

      .book-landing__breadcrumb ol {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .book-landing__breadcrumb li + li::before {
        margin-right: 0.4rem;
        content: "/";
      }

      .book-landing__breadcrumb a:hover,
      .book-landing__breadcrumb a:focus-visible {
        color: #d9b56d;
      }
    </style>
